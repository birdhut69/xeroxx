{
  "name": "CipherPrint - Zero-Disk Ephemeral Print",
  "short_name": "CipherPrint",
  "description": "Zero-knowledge, end-to-end encrypted, RAM-only document printing platform for Xerox and print shops.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#efeae2",
  "theme_color": "#075E54",
  "orientation": "any",
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "documents",
          "accept": [
            "application/pdf",
            "image/*",
            ".pdf",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp"
          ]
        }
      ]
    }
  },
  "categories": ["utilities", "productivity", "business"]
}
